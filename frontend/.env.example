# API Configuration
# For local development, use: http://localhost:5000/api
# For production, use your hosted backend URL
NEXT_PUBLIC_API_URL=https://colorra-web-app.onrender.com/api

# Frontend URL (optional, for email links)
# NEXT_PUBLIC_FRONTEND_URL=https://your-frontend-url.vercel.app

# Google OAuth Configuration
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Must match the GOOGLE_CLIENT_ID in your backend .env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
